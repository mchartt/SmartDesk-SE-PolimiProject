# Copy this file to .env for local development and fill values.
# Never commit real credentials.

SPRING_PROFILES_ACTIVE=dev
SECURITY_ACCESS_TOKEN_SECRET=QuestaEunaChiaveSuperSegretaMoltoLungaPerGarantireLaSicurezzaDeiToken123!
ALLOWED_ORIGINS=https://yourdomain.com

# Production profile database variables
DB_URL=jdbc:mysql://localhost:3306/smartdesk
DB_USERNAME=smartdesk_user
DB_PASSWORD=replace-me

# Optional initial seeding users
APP_SEED_ADMIN_EMAIL=
APP_SEED_ADMIN_PASSWORD=
APP_SEED_TECHNICIAN_EMAIL=
APP_SEED_TECHNICIAN_PASSWORD=
